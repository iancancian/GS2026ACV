<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_BocaDeLobo" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_BocaDeLobo" name="Inspecao preventiva de bocas de lobo" isExecutable="false">
    <bpmn:startEvent id="inicio" name="Lote agendado antes do temporal"><bpmn:outgoing>f01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:serviceTask id="ler" name="Ler áreas de risco e lista de inspeções (CSV)"><bpmn:incoming>f01</bpmn:incoming><bpmn:outgoing>f02</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g_entradas" name="Entradas válidas?"><bpmn:incoming>f02</bpmn:incoming><bpmn:outgoing>f03</bpmn:outgoing><bpmn:outgoing>f04</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:endEvent id="abortar" name="Abortar e registrar erro (código 2)"><bpmn:incoming>f04</bpmn:incoming><bpmn:errorEventDefinition /></bpmn:endEvent>
    <bpmn:serviceTask id="previsao" name="Consultar previsão de chuva por área (API, 3 tentativas)"><bpmn:incoming>f03</bpmn:incoming><bpmn:outgoing>f05</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g_previsao" name="Previsão disponível?"><bpmn:incoming>f05</bpmn:incoming><bpmn:outgoing>f06</bpmn:outgoing><bpmn:outgoing>f07</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="indisponivel" name="Marcar previsão indisponível (nunca assumir sem chuva)"><bpmn:incoming>f07</bpmn:incoming><bpmn:outgoing>f08</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="validar" name="Validar registro, área e imagem"><bpmn:incoming>f06</bpmn:incoming><bpmn:incoming>f08</bpmn:incoming><bpmn:incoming>f16</bpmn:incoming><bpmn:outgoing>f09</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g_valido" name="Registro válido?"><bpmn:incoming>f09</bpmn:incoming><bpmn:outgoing>f10</bpmn:outgoing><bpmn:outgoing>f11</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="detectar" name="Detectar bueiro e obstruções (YOLO)"><bpmn:incoming>f10</bpmn:incoming><bpmn:outgoing>f12</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="cobertura" name="Calcular cobertura, estado e prioridade"><bpmn:incoming>f12</bpmn:incoming><bpmn:outgoing>f13</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="registrar" name="Registrar item e log de auditoria"><bpmn:incoming>f13</bpmn:incoming><bpmn:outgoing>f14</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g_mais" name="Há mais inspeções?"><bpmn:incoming>f14</bpmn:incoming><bpmn:incoming>f15</bpmn:incoming><bpmn:outgoing>f16</bpmn:outgoing><bpmn:outgoing>f17</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="rejeitar" name="Registrar rejeição no log e seguir"><bpmn:incoming>f11</bpmn:incoming><bpmn:outgoing>f15</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="gerar" name="Gerar fila de ações, tarefas de limpeza e avisos (JSON/CSV)"><bpmn:incoming>f17</bpmn:incoming><bpmn:outgoing>f18</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="aprovar" name="Equipe revisa e aprova ações e avisos (humano)"><bpmn:incoming>f18</bpmn:incoming><bpmn:outgoing>f19</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="fim" name="MVP consome os arquivos"><bpmn:incoming>f19</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="f01" sourceRef="inicio" targetRef="ler" />
    <bpmn:sequenceFlow id="f02" sourceRef="ler" targetRef="g_entradas" />
    <bpmn:sequenceFlow id="f03" name="Sim" sourceRef="g_entradas" targetRef="previsao" />
    <bpmn:sequenceFlow id="f04" name="Não" sourceRef="g_entradas" targetRef="abortar" />
    <bpmn:sequenceFlow id="f05" sourceRef="previsao" targetRef="g_previsao" />
    <bpmn:sequenceFlow id="f06" name="Sim" sourceRef="g_previsao" targetRef="validar" />
    <bpmn:sequenceFlow id="f07" name="Não" sourceRef="g_previsao" targetRef="indisponivel" />
    <bpmn:sequenceFlow id="f08" sourceRef="indisponivel" targetRef="validar" />
    <bpmn:sequenceFlow id="f09" sourceRef="validar" targetRef="g_valido" />
    <bpmn:sequenceFlow id="f10" name="Sim" sourceRef="g_valido" targetRef="detectar" />
    <bpmn:sequenceFlow id="f11" name="Não" sourceRef="g_valido" targetRef="rejeitar" />
    <bpmn:sequenceFlow id="f12" sourceRef="detectar" targetRef="cobertura" />
    <bpmn:sequenceFlow id="f13" sourceRef="cobertura" targetRef="registrar" />
    <bpmn:sequenceFlow id="f14" sourceRef="registrar" targetRef="g_mais" />
    <bpmn:sequenceFlow id="f15" sourceRef="rejeitar" targetRef="g_mais" />
    <bpmn:sequenceFlow id="f16" name="Sim" sourceRef="g_mais" targetRef="validar" />
    <bpmn:sequenceFlow id="f17" name="Não" sourceRef="g_mais" targetRef="gerar" />
    <bpmn:sequenceFlow id="f18" sourceRef="gerar" targetRef="aprovar" />
    <bpmn:sequenceFlow id="f19" sourceRef="aprovar" targetRef="fim" />
  </bpmn:process>
